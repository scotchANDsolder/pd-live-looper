#N canvas 40 40 800 950 12;
#X obj 20 40 bng 15 250 50 0 empty empty empty 17 7 0 10 -262144 -1 -1;
#X obj 20 80 openpanel;
#X msg 20 120 read -resize $1 trackArray;
#X obj 20 160 soundfiler;
#X floatatom 220 40 6 0 100 0 - - - 0;
#X floatatom 300 40 6 0 100 0 - - - 0;
#X floatatom 380 40 6 0 0 0 - - - 0;
#X obj 220 100 expr $f2-$f1;
#X obj 300 140 expr $f2*44100/($f1+0.000001);
#X obj 300 190 phasor~;
#X obj 300 230 *~ 1;
#X obj 300 270 +~ 0;
#X obj 300 310 tabread4~ trackArray;
#X obj 300 350 *~ 0;
#X obj 300 390 dac~;
#X obj 440 350 tgl 15 0 empty empty empty 17 7 0 10 -262144 -1 -1 0 1;
#X obj 440 40 loadbang;
#X msg 440 80 1;
#N canvas 0 0 450 300 (subpatch) 0;
#X array trackArray 44100 float 0;
#X coords 0 1 44100 -1 200 100 1 0 0;
#X restore 20 440 graph;
#X text 20 10 LOAD WAV;
#X text 210 10 start %;
#X text 290 10 end %;
#X text 370 10 speed;
#X text 430 10 speed init;
#X text 420 330 play/stop;
#X text 20 580 Single-track loop player -- Phase 1. Click the button to load a WAV. Set start/end as a percent (0-100) of the loaded sample's length\; they reset to 0/100 on every new load. Speed is a multiplier (1 = normal speed). Toggle plays/stops.;
#X obj 150 90 route symbol;
#X obj 150 130 list prepend read -resize;
#X obj 150 160 list append trackArray;
#X obj 150 190 list trim;
#X text 20 610 Note: the old "read -resize \$1 trackArray" message box above is no longer used (kept only so object numbering did not shift) -- the list chain to the right replaces it and handles filenames with spaces correctly.;
#X obj 550 100 expr $f1*$f2/100;
#X obj 550 140 expr $f1*$f2/100;
#X obj 550 40 t b f f;
#X msg 550 200 0;
#X msg 620 200 100;
#X text 550 10 percent -> samples (uses last-loaded sample count);
#X obj 650 100 pack 0 0;
#X obj 650 130 t b f;
#X obj 650 160 unpack f f;
#X obj 650 220 pack 0 0;
#X obj 650 250 t b f;
#X obj 650 280 unpack f f;
#X text 650 10 refresh-on-either-input fix (pack/unpack);
#X text 20 645 ECHO EFFECT;
#X text 20 665 echo on/off;
#X text 140 665 delay ms;
#X text 230 665 feedback;
#X text 320 665 wet mix;
