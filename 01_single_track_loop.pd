#X floatatom 140 685 6 1 2000 0 - - - 0;
#X floatatom 230 685 6 0 0.95 0 - - - 0;
#X floatatom 320 685 6 0 1 0 - - - 0;
#X obj 20 730 +~;
#X obj 20 770 delwrite~ echoline 2000;
#X obj 20 810 delread~ echoline 250;
